# Proje 15: Londra Gerçek Zamanlı Akıllı Şehir Veri Platformu
# Tüm açık API'ler ücretsiz ve API anahtarsızdır (TfL Road, Open-Meteo, Elexon BMRS, NESO Region 13).

# Streaming & Generator Ayarları
DEFAULT_RATE=100
MAX_EVENT_RATE=25000
API_POLL_INTERVAL_SEC=60
TRIGGER_INTERVAL_SEC=2

# Spark Structured Streaming Altyapı Ayarları
SPARK_MASTER=local[4]
SPARK_DRIVER_MEMORY=1280m
SPARK_SHUFFLE_PARTITIONS=8
MAX_OFFSETS_PER_TRIGGER=50000

# Data Lake Disk Koruma & Durum Ayarları
ARCHIVE_EVERY_N_BATCHES=10
ARCHIVE_CSV_ENABLED=false
LAKE_MAX_SIZE_MB=512
RESET_STATE_ON_START=false

# MSSQL Kalıcı Veritabanı Ayarları (SSMS: localhost,1434 | User: sa)
MSSQL_ENABLED=true
MSSQL_HOST_PORT=1434
MSSQL_PID=Developer
MSSQL_DATABASE=SmartCityDB
MSSQL_USER=sa
MSSQL_SA_PASSWORD=SmartCity#2026!
MSSQL_MEMORY_LIMIT_MB=1536
MSSQL_WRITE_EVERY_N_BATCHES=1
MSSQL_RETENTION_DAYS=90

# 7/24 Bulut Toplayıcı (GitHub Actions -> data-archive) & MSSQL Otomatik Eksik Saat Tamamlama
# Public repo için token gerekmez; yalnızca CLOUD_ARCHIVE_REPO=kullanici_adiniz/repo_adiniz yazmanız yeterlidir.
MSSQL_AUTO_BACKFILL_ENABLED=true
MSSQL_AUTO_BACKFILL_HOURS=72
MSSQL_BACKFILL_ALLOW_TRAFFIC_MODEL=false
CLOUD_ARCHIVE_REPO=
CLOUD_ARCHIVE_BRANCH=data-archive
CLOUD_ARCHIVE_TOKEN=
CLOUD_SYNC_INTERVAL_MIN=30

# Backend Güvenlik (CORS izinli kaynaklar, virgülle ayrılmış)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Benchmark Ölçek & Bellek Ayarları (100K / 1M / 5M / 10M / 20M+ destekler)
BENCHMARK_SPARK_MASTER=local[4]
BENCHMARK_DRIVER_MEMORY=3g
BENCHMARK_SCALES=100000,1000000,5000000
BENCHMARK_STREAM_RATES=100,500,2000,5000
